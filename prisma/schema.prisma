datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// โมเดลข้อมูลหนังสือ มีความสัมพันธ์แบบ 1-to-Many กับโมเดล Review
model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  publishedAt DateTime @default(now())
  coverUrl    String?
  reviews     Review[]
}

// โมเดลข้อมูลรีวิวหนังสือ เชื่อมโยงกับ Book ผ่าน bookId
model Review {
  id      Int    @id @default(autoincrement())
  rating  Int
  content String
  bookId  Int
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
}
